<?xml version="1.0"?>
<sdf version="1.7">
  <world name="ur3e_workcell">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Sim 6 / Fortress server systems. -->
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65</ambient>
      <background>0.82 0.84 0.88</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 1.40 x 1.10 m work table. Its top surface is at z=0.70 m. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <visual name="top_visual">
          <pose>0.25 0 0.675 0 0 0</pose>
          <geometry><box><size>1.40 1.10 0.05</size></box></geometry>
          <material><ambient>0.40 0.28 0.16 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material>
        </visual>
        <collision name="top_collision">
          <pose>0.25 0 0.675 0 0 0</pose>
          <geometry><box><size>1.40 1.10 0.05</size></box></geometry>
        </collision>
        <visual name="leg_fl"><pose>-0.35 -0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient></material></visual>
        <collision name="leg_fl_collision"><pose>-0.35 -0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry></collision>
        <visual name="leg_fr"><pose>-0.35 0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient></material></visual>
        <collision name="leg_fr_collision"><pose>-0.35 0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry></collision>
        <visual name="leg_bl"><pose>0.85 -0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient></material></visual>
        <collision name="leg_bl_collision"><pose>0.85 -0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry></collision>
        <visual name="leg_br"><pose>0.85 0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient></material></visual>
        <collision name="leg_br_collision"><pose>0.85 0.45 0.325 0 0 0</pose><geometry><box><size>0.07 0.07 0.65</size></box></geometry></collision>
      </link>
    </model>

    <!-- Rigid, dynamic 5 x 5 x 7 cm boxes, 5 g each. Positive mass and
         box-consistent inertia keep DART stable; friction holds a pinched box. -->
    <model name="red_box">
      <pose>0.144721 -0.389443 0.735 0 0 0</pose>
      <link name="link"><inertial><mass>0.001</mass><inertia><ixx>0.0000030833335</ixx><iyy>0.0000030833335</iyy><izz>0.0000020833335</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.03 0.03 1</diffuse></material></visual></link>
    </model>
    <model name="yellow_box">
      <pose>0.170711 -0.220711 0.735 0 0 0</pose>
      <link name="link"><inertial><mass>0.001</mass><inertia><ixx>0.0000030833335</ixx><iyy>0.0000030833335</iyy><izz>0.0000020833335</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><material><ambient>0.85 0.75 0.02 1</ambient><diffuse>1 0.9 0.03 1</diffuse></material></visual></link>
    </model>
    <model name="green_box">
      <pose>0.25 0 0.735 0 0 0</pose>
      <link name="link"><inertial><mass>0.001</mass><inertia><ixx>0.0000030833335</ixx><iyy>0.0000030833335</iyy><izz>0.0000020833335</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><material><ambient>0.02 0.65 0.08 1</ambient><diffuse>0.03 0.9 0.10 1</diffuse></material></visual></link>
    </model>
    <model name="blue_box">
      <pose>0.170711 0.220711 0.735 0 0 0</pose>
      <link name="link"><inertial><mass>0.001</mass><inertia><ixx>0.0000030833335</ixx><iyy>0.0000030833335</iyy><izz>0.0000020833335</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><material><ambient>0.02 0.12 0.75 1</ambient><diffuse>0.03 0.18 1 1</diffuse></material></visual></link>
    </model>
    <model name="purple_box">
      <pose>0.144721 0.389443 0.735 0 0 0</pose>
      <link name="link"><inertial><mass>0.001</mass><inertia><ixx>0.0000030833335</ixx><iyy>0.0000030833335</iyy><izz>0.0000020833335</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.07</size></box></geometry><material><ambient>0.48 0.03 0.65 1</ambient><diffuse>0.68 0.05 0.9 1</diffuse></material></visual></link>
    </model>

    <!-- Thin, collision-free zones in a row along +Y, with 20 mm gaps.
         Camera left to right: Intermediate, red, green, yellow.
         Centred along table X at x=0.25; red contains the green box.
         Other boxes stay outside all zones (minimum edge clearance 4.289 mm). -->
    <model name="zone_1_red">
      <static>true</static><pose>0.25 0.00 0.7025 0 0 0</pose><link name="link"><visual name="visual"><transparency>0.28</transparency><geometry><box><size>0.10 0.10 0.005</size></box></geometry><material><ambient>0.75 0.05 0.05 0.72</ambient><diffuse>0.9 0.08 0.08 0.72</diffuse></material></visual></link>
    </model>
    <model name="zone_2_green">
      <static>true</static><pose>0.25 0.12 0.7025 0 0 0</pose><link name="link"><visual name="visual"><transparency>0.28</transparency><geometry><box><size>0.10 0.10 0.005</size></box></geometry><material><ambient>0.05 0.65 0.08 0.72</ambient><diffuse>0.08 0.9 0.12 0.72</diffuse></material></visual></link>
    </model>
    <model name="zone_3_yellow">
      <static>true</static><pose>0.25 0.24 0.7025 0 0 0</pose><link name="link"><visual name="visual"><transparency>0.28</transparency><geometry><box><size>0.10 0.10 0.005</size></box></geometry><material><ambient>0.75 0.65 0.05 0.72</ambient><diffuse>0.95 0.85 0.08 0.72</diffuse></material></visual></link>
    </model>

    <!-- Auxiliary staging area only. The primary destination zones remain
         zone_1_red, zone_2_green and zone_3_yellow. -->
    <model name="zone_Intermediate">
      <static>true</static>
      <pose>0.25 -0.12 0.7025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <transparency>0.28</transparency>
          <geometry><box><size>0.10 0.10 0.005</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 0.72</ambient>
            <diffuse>0.60 0.60 0.60 0.72</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Steep overhead view aimed at (0.30, 0, 0.7025), near the main-zone centre.
         The Gazebo camera looks along +X; the zone row runs horizontally along world +Y. -->
    <model name="workcell_camera">
      <static>true</static>
      <pose>0.65 0 1.75 0 1.24832995 3.14159265</pose>
      <link name="camera_link">
        <!-- Keep the complete housing and decorative lens behind the sensor
             origin. A lens in front of +X occludes the entire camera image. -->
        <visual name="body"><pose>-0.075 0 0 0 0 0</pose><geometry><box><size>0.10 0.08 0.07</size></box></geometry><material><ambient>0.08 0.08 0.10 1</ambient><diffuse>0.12 0.12 0.15 1</diffuse></material></visual>
        <visual name="lens"><pose>-0.015 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry><material><ambient>0.05 0.10 0.20 1</ambient><diffuse>0.08 0.18 0.35 1</diffuse></material></visual>
        <sensor name="rgb_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera name="workcell_camera">
            <camera_info_topic>/workcell_camera/camera_info</camera_info_topic>
            <optical_frame_id>workcell_camera_optical_frame</optical_frame_id>
            <horizontal_fov>0.90</horizontal_fov>
            <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>3.0</far></clip>
          </camera>
          <!-- Native Gazebo Transport topics, bridged to ROS 2 by the launch file. -->
          <topic>/workcell_camera/image_raw</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
